# ==========================================================
# ScientiCO OJS — Git Ignore
# Repository publik: jangan simpan rahasia atau data runtime
# ==========================================================

# ----------------------------------------------------------
# Konfigurasi sensitif
# ----------------------------------------------------------
.env
.env.*
!.env.example

config.inc.php
config.inc.php.*
!config.example.inc.php

docker-compose.yml
docker-compose.yml.*
!docker-compose.example.yml

# ----------------------------------------------------------
# Database, backup, dan paket pemulihan
# ----------------------------------------------------------
restore/

*.sql
*.sql.gz
*.dump
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

*.bak
*.bak-*
*.backup
*.backup-*
*.old

# Dokumen atau paket privat
PETUNJUK-PRIVATE.txt

# ----------------------------------------------------------
# Data OJS dan file unggahan pengguna
# ----------------------------------------------------------
ojs-files/

ojs-public/*
!ojs-public/.htaccess
!ojs-public/index.html

ojs-runtime-public/*
!ojs-runtime-public/.gitkeep

# ----------------------------------------------------------
# Tema bawaan
# Hanya simpan dua file kustomisasi yang digunakan
# ----------------------------------------------------------
ojs-theme/default/**

!ojs-theme/default/
!ojs-theme/default/DefaultThemePlugin.php

!ojs-theme/default/styles/
!ojs-theme/default/styles/custom.css

# ----------------------------------------------------------
# Cache, log, dan file sementara
# ----------------------------------------------------------
cache/
tmp/
temp/

*.log
*.pid
*.swp
*.swo
*~

# ----------------------------------------------------------
# Editor dan helper lokal
# ----------------------------------------------------------
.vscode/
.ide-stubs/
.idea/

.DS_Store
Thumbs.db
desktop.ini

# File khusus Windows yang tidak perlu masuk repository
NUL

# ----------------------------------------------------------
# Skrip pemulihan sementara yang tidak lagi digunakan
# ----------------------------------------------------------
fix-ojs-local.sh
recover-mariadb-access.sh

# ----------------------------------------------------------
# File cadangan GitIgnore
# ----------------------------------------------------------
.gitignore.backup*

# Dokumen dan pengaturan lokal privat
PETUNJUK-PRIVAT.txt
SUMBER-BACKUP.txt
settings.json

# Salinan dokumentasi lokal
